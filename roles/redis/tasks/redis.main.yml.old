# - name: Configuring memory settings
  # WARNING overcommit_memory is set to 0! Background save may fail under low memory condition. 
  # To fix this issue add 'vm.overcommit_memory = 1' to /etc/sysctl.conf 
  # and then reboot or run the command 'sysctl vm.overcommit_memory=1' for this to take effect.
  # shell: sysctl vm.overcommit_memory=1

- name: Configuring {{COMPONENT}} .conf file
  replace:
    # path: /etc/{{COMPONENT}}/{{COMPONENT}}.conf
    path: /etc/redis.conf
    regexp: '127.0.0.1'
    replace: '0.0.0.0'

- name: Starting {{COMPONENT}} service
  systemd:
   daemon_reload: yes
   enabled: yes
   state: restarted
   name: "{{COMPONENT}}"

